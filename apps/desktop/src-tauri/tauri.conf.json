{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-app-desktop",
  "version": "0.1.0",
  "identifier": "dev.omp-app.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "Barry Shen <BarryTheShen@users.noreply.github.com>",
    "category": "DeveloperTool",
    "shortDescription": "Desktop window for the omp coding agent",
    "longDescription": "A window around the omp app: a chat app for the omp coding agent. omp must be installed separately.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "externalBin": ["binaries/omp-app-desktop-server"],
    "resources": {
      "resources/web": "web"
    },
    "linux": {
      "deb": {
        "recommends": ["xdg-utils", "gstreamer1.0-tools"],
        "depends": ["libc6 (>= 2.39)"],
        "desktopTemplate": "linux/omp-app-desktop.desktop.hbs"
      }
    }
  }
}
