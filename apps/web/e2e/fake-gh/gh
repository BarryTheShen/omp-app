#!/bin/sh
# A stand-in for the GitHub CLI in real-omp specs. The app's server finds it first on PATH (serverEnv).
# `gh --version` succeeds, `gh search issues` finds issue #12 for any query, and `gh search prs` finds
# nothing. Every other command reports that there is no pull request, as `gh pr view` does on a branch
# without one.
case "$1" in
  --version)
    echo "gh version 2.0.0 (fake for omp-app e2e)"
    ;;
  search)
    if [ "$2" = "issues" ]; then
      echo '[{"number":12,"title":"Fake issue for the e2e","body":"","url":"https://github.com/example/omp-app/issues/12","state":"open"}]'
    else
      echo '[]'
    fi
    ;;
  *)
    echo "no pull request found" >&2
    exit 1
    ;;
esac
