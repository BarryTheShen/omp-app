Icon={{icon}}
Terminal=false
Categories={{categories}}
Keywords=omp;agent;coding;chat;
StartupNotify=true
MimeType=x-scheme-handler/omp-app;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec={{exec}} --new-window
