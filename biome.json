{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!apps/ui/src/vendor"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["apps/ui/public/favicon.svg"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    },
    {
      "includes": ["apps/ui/src/components/ui/input-group.tsx"],
      "linter": {
        "rules": { "a11y": { "useSemanticElements": "off", "useKeyWithClickEvents": "off" } }
      }
    },
    {
      "includes": ["apps/ui/src/components/ui/chart.tsx"],
      "linter": {
        "rules": {
          "security": { "noDangerouslySetInnerHtml": "off" },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    }
  ]
}
