{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "./src/vendor",
    "outDir": "./node_modules/.tmp/vendor-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vendor.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/vendor"]
}
