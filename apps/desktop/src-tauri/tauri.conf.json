{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-app-desktop",
  "version": "0.1.0",
  "identifier": "dev.omp-app.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "Barry Shen <BarryTheShen@users.noreply.github.com>",
    "category": "DeveloperTool",
    "shortDescription": "Desktop window for the omp coding agent",
    "longDescription": "A window around the omp app: a chat app for the omp coding agent. The window bundles the omp it runs: omp's own command line, built from the omp release the app pins.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ui": "ui",
      "resources/chat-host": "chat-host",
      "resources/omp-app-desktop-server": "omp-app-desktop-server",
      "resources/pi_natives.linux-x64-modern.node": "pi_natives.linux-x64-modern.node",
      "resources/pi_natives.linux-x64-baseline.node": "pi_natives.linux-x64-baseline.node"
    },
    "linux": {
      "deb": {
        "recommends": ["xdg-utils", "gstreamer1.0-tools", "libayatana-appindicator3-1"],
        "depends": ["libc6 (>= 2.39)"],
        "conflicts": ["omp-app-device"],
        "replaces": ["omp-app-device"],
        "desktopTemplate": "linux/omp-app-desktop.desktop.hbs",
        "files": {
          "/usr/lib/omp-app-device": "../../../dist/device-stage/usr/lib/omp-app-device",
          "/usr/bin/omp-app-device": "../../../dist/device-stage/usr/bin/omp-app-device",
          "/usr/lib/systemd/system/omp-app-device-guard.service": "../../../dist/device-stage/usr/lib/systemd/system/omp-app-device-guard.service",
          "/usr/lib/systemd/system/omp-agent-access.slice": "../../../dist/device-stage/usr/lib/systemd/system/omp-agent-access.slice",
          "/usr/lib/systemd/user/omp-app-device.service": "../../../dist/device-stage/usr/lib/systemd/user/omp-app-device.service",
          "/usr/share/polkit-1/actions/dev.ompapp.device.policy": "../../../dist/device-stage/usr/share/polkit-1/actions/dev.ompapp.device.policy",
          "/usr/share/doc/omp-app-device": "../../../dist/device-stage/usr/share/doc/omp-app-device"
        },
        "postInstallScript": "linux/postinst.sh",
        "preRemoveScript": "linux/prerm.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
