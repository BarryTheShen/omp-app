{
  "manifest_version": 3,
  "name": "omp app",
  "version": "0.1.0",
  "description": "omp app's chat in the sidebar: it reads and acts on the tab you open it on, and on tabs it opens, and no other.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-panel@omp-app.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "omp app: chat about this tab",
    "default_icon": "icon.svg"
  },
  "sidebar_action": {
    "default_title": "omp app",
    "default_panel": "panel.html",
    "default_icon": "icon.svg",
    "open_at_install": false
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
