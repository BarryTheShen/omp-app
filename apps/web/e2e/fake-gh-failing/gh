#!/bin/sh
# A stand-in for the GitHub CLI in the #1335 real-omp spec. It runs, but every search fails, as an outage would.
case "$1" in
  --version)
    echo "gh version 2.0.0 (fake for omp-app e2e)"
    ;;
  search)
    echo "error connecting to api.github.com" >&2
    exit 1
    ;;
  *)
    echo "no pull request found" >&2
    exit 1
    ;;
esac
